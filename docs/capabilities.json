{
  "schema_version": "1",
  "release_tier": "public-alpha",
  "canonical_contract": "rest",
  "rest": {
    "base_path": "/api/v1",
    "openapi_path": "/openapi.yaml",
    "error_envelope_version": "1"
  },
  "surfaces": ["rest", "sdk-js", "cli", "mcp", "web", "git", "hugging-face-read"],
  "repository_kinds": ["code", "model", "dataset"],
  "agent": {
    "transport": "streamable-http",
    "path": "/mcp",
    "scoped_tokens": true,
    "tool_discovery_is_scope_filtered": true,
    "untrusted_content_is_authority": false
  },
  "limits": {
    "default_page_size": 50,
    "maximum_page_size": 100,
    "idempotency_key_max_bytes": 128,
    "idempotency_retention_hours": 24
  },
  "providers": {
    "compute": ["daytona", "box", "computesdk"],
    "storage": ["arachne", "storagesdk"],
    "network": ["public", "tailscale"],
    "hub": ["huggingface"],
    "auth": ["bootstrap", "clerk"]
  },
  "stability": "alpha"
}
