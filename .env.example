# Clotho dev environment — copy to `.env` (gitignored) and fill in.
# docker-compose.dev.yml reads these; unset values fall back to safe defaults.
#
# Provider API keys (Daytona, Box, E2B, …) belong in the Clotho web console
# (Settings → Secrets / Connect provider), not as the primary path here.
# See docs/adr/0014-secrets-storage-and-resolution.md and Stage 14 notes.

# --- Bootstrap secrets (required for secrets + control plane) ---------------
# 32-byte AES-256-GCM master key for sealing org/repo secrets at rest.
#
# Generate safely (run in your shell; paste only the OUTPUT into this file):
#
#   openssl rand -hex 32
#
# That prints 64 hex characters. Example shape (not a real key):
#   a1b2c3d4e5f6... (64 hex chars total)
#
# Or base64 (also accepted by the gateway):
#   openssl rand -base64 32
#
# NEVER put the shell command itself into this file:
#   BAD:  CLOTHO_SECRETS_MASTER_KEY=$(openssl rand -hex 32)
#   BAD:  CLOTHO_SECRETS_MASTER_KEY=openssl rand -hex 32
# Docker Compose does not expand $(...) here; you would store a useless string.
#
# Without this, secret write/resolve is disabled; the stack still boots.
CLOTHO_SECRETS_MASTER_KEY=

# --- Stage 7/12/14: pluggable compute (CCI registry, docs/adr/0013) ---------
# Default provider id when Actions config omits one
# (daytona | computesdk | box | disabled).
# CLOTHO_COMPUTE_PROVIDER=daytona

# Dev escape hatch only — prefer Clotho Settings → Compute → Connect Daytona.
# Create a key at https://app.daytona.io/dashboard/keys (scopes: write:sandboxes).
# When unset, Daytona can still run jobs if a Clotho secret DAYTONA_API_KEY exists.
# DAYTONA_API_KEY=

# Optional Daytona overrides:
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_PROXY_URL=https://proxy.app.daytona.io
# DAYTONA_TARGET=us
# DAYTONA_ORGANIZATION_ID=
# CLOTHO_COMPUTE_SNAPSHOT=daytona-small

# Optional ComputeSDK TypeScript sidecar (Stage 14).
# Compose default (in-cluster): http://clotho-compute-sdk-bridge:8091
# Start sidecar: `just dev-compute-bridge` (profile compute-bridge).
# Prefer Clotho secrets E2B_API_KEY / MODAL_TOKEN_* over host env.
# CLOTHO_COMPUTE_SDK_BRIDGE_URL=http://clotho-compute-sdk-bridge:8091
# CLOTHO_COMPUTE_SDK_STRATEGY=priority
# CLOTHO_COMPUTE_SDK_FALLBACK=true
# Sidecar upstream keys (never returned by Clotho APIs):
# E2B_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional Box (Ascii) — prefer Settings → Compute → Connect Box.
# When unset, Box still runs jobs if a Clotho secret BOX_API_KEY exists.
# BOX_API_KEY=
# BOX_API_URL=https://ascii.dev/api/box/v1
# BOX_DEFAULT_TTL_SECS=3600

# --- CI / Actions -----------------------------------------------------------
# Shared secret for push webhook HMAC (api-gateway). Change beyond local dev.
# CLOTHO_WEBHOOK_SECRET=clotho-webhook-dev
# CLOTHO_WEB_URL=http://localhost:3100
# CLOTHO_ACTIONS_TIMEOUT_SECONDS=900
