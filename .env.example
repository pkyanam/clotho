# Clotho dev environment — copy to `.env` (gitignored) and fill in.
# docker-compose.dev.yml reads these; unset values fall back to safe defaults.

# --- Stage 7/12: pluggable compute (CCI registry, docs/adr/0013) ------------
# Default provider id used when Actions config omits one (must match a
# registry id: daytona | computesdk | box | disabled).
# CLOTHO_COMPUTE_PROVIDER=daytona

# Daytona — stable direct Rust provider (docs/adr/0008).
# Create an API key at https://app.daytona.io/dashboard/keys
# (scopes: write:sandboxes). With this unset, Daytona is listed as
# unconfigured; the stack stays healthy and CI jobs fail cleanly.
DAYTONA_API_KEY=

# Optional Daytona overrides (defaults shown as comments):
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_PROXY_URL=https://proxy.app.daytona.io
# DAYTONA_TARGET=us
# DAYTONA_ORGANIZATION_ID=
# Sandbox snapshot the CI job runs in (must have git; a compiler/runtime if the
# checked-out repo needs one). Defaults to daytona-small.
# CLOTHO_COMPUTE_SNAPSHOT=daytona-small

# Optional ComputeSDK TypeScript sidecar behind CCI (docs/adr/0013).
# Point at services/compute-sdk-bridge when running it (default port 8091).
# Without this URL the computesdk registry entry is unconfigured.
# CLOTHO_COMPUTE_SDK_BRIDGE_URL=http://localhost:8091
# Sidecar multi-provider strategy (see https://docs.computesdk.com/llms.txt):
# CLOTHO_COMPUTE_SDK_STRATEGY=priority
# CLOTHO_COMPUTE_SDK_FALLBACK=true
# Upstream keys for the sidecar only (never returned by Clotho APIs):
# E2B_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional Box persistent VM provider stub (https://docs.ascii.dev/llms.txt).
# API base: https://ascii.dev/api/box/v1 — bearer BOX_API_KEY (box_…).
# Stage 12 registers capabilities only; full HTTP client is a later stage.
# BOX_API_KEY=
# BOX_API_URL=https://ascii.dev/api/box/v1

# --- CI / Actions -----------------------------------------------------------
# Shared secret Forgejo signs push webhooks with (HMAC-SHA256), verified by the
# api-gateway. Change it for anything beyond local dev.
# CLOTHO_WEBHOOK_SECRET=clotho-webhook-dev
# Web app base URL used for commit-status target links.
# CLOTHO_WEB_URL=http://localhost:3100
# CLOTHO_ACTIONS_TIMEOUT_SECONDS=900
